<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Override for API 27+ to add windowLightNavigationBar -->
    <style name="Theme.KafkaMusicPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color - Kafka's thread magenta -->
        <item name="colorPrimary">@color/kafka_thread_bright</item>
        <item name="colorPrimaryVariant">@color/kafka_deep_magenta</item>
        <item name="colorOnPrimary">@color/kafka_text_primary</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/kafka_rose</item>
        <item name="colorSecondaryVariant">@color/kafka_thread_dark</item>
        <item name="colorOnSecondary">@color/kafka_pale_pink</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/kafka_dark_wine</item>
        <item name="colorSurface">@color/kafka_card_bg</item>
        <item name="colorOnSurface">@color/kafka_text_primary</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/kafka_deepest_wine</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/kafka_dark_wine</item>
        <!-- ✅ API 27+ only attribute -->
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Window background -->
        <item name="android:windowBackground">@drawable/kafka_gradient_bg</item>
        
        <!-- Remove title bar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/kafka_text_primary</item>
        <item name="android:textColorSecondary">@color/kafka_text_secondary</item>
        <item name="android:textColorTertiary">@color/kafka_text_tertiary</item>
        
        <!-- Action bar -->
        <item name="colorControlNormal">@color/kafka_text_secondary</item>
        <item name="colorControlActivated">@color/kafka_thread_bright</item>
        <item name="colorControlHighlight">@color/kafka_thread_glow</item>
        
        <!-- Buttons -->
        <item name="materialButtonStyle">@style/KafkaButton</item>
        
        <!-- Cards -->
        <item name="materialCardViewStyle">@style/KafkaCard</item>
        
        <!-- Dialogs -->
        <item name="alertDialogTheme">@style/KafkaDialog</item>
    </style>
</resources>