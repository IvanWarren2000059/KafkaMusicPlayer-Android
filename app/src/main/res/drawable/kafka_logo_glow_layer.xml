<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow layer 1 (most spread) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#20E84393"/>
        </shape>
    </item>
    
    <!-- Outer glow layer 2 -->
    <item android:left="40dp" android:top="40dp" android:right="40dp" android:bottom="40dp">
        <shape android:shape="oval">
            <solid android:color="#40E84393"/>
        </shape>
    </item>
    
    <!-- Outer glow layer 3 (closest to logo) -->
    <item android:left="80dp" android:top="80dp" android:right="80dp" android:bottom="80dp">
        <shape android:shape="oval">
            <solid android:color="#60E84393"/>
        </shape>
    </item>
</layer-list>
