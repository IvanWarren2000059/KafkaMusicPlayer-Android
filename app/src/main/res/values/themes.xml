<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KafkaMusicPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color - Kafka's thread magenta -->
        <item name="colorPrimary">@color/kafka_thread_bright</item>
        <item name="colorPrimaryVariant">@color/kafka_deep_magenta</item>
        <item name="colorOnPrimary">@color/kafka_text_primary</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/kafka_rose</item>
        <item name="colorSecondaryVariant">@color/kafka_thread_dark</item>
        <item name="colorOnSecondary">@color/kafka_pale_pink</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/kafka_dark_wine</item>
        <item name="colorSurface">@color/kafka_card_bg</item>
        <item name="colorOnSurface">@color/kafka_text_primary</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/kafka_deepest_wine</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/kafka_dark_wine</item>
        
        <!-- Window background -->
        <item name="android:windowBackground">@drawable/kafka_gradient_bg</item>
        
        <!-- Remove title bar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/kafka_text_primary</item>
        <item name="android:textColorSecondary">@color/kafka_text_secondary</item>
        <item name="android:textColorTertiary">@color/kafka_text_tertiary</item>
        
        <!-- DEFAULT FONT FAMILY - Elegant serif for Kafka theme -->
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="fontFamily">sans-serif-light</item>
        
        <!-- Action bar -->
        <item name="colorControlNormal">@color/kafka_text_secondary</item>
        <item name="colorControlActivated">@color/kafka_thread_bright</item>
        <item name="colorControlHighlight">@color/kafka_thread_glow</item>
        
        <!-- Buttons -->
        <item name="materialButtonStyle">@style/KafkaButton</item>
        
        <!-- Cards -->
        <item name="materialCardViewStyle">@style/KafkaCard</item>
        
        <!-- Dialogs -->
        <item name="alertDialogTheme">@style/KafkaDialog</item>
        
        <!-- Text Input -->
        <item name="textInputStyle">@style/KafkaTextInput</item>
    </style>
    
    <!-- Button style -->
    <style name="KafkaButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/kafka_thread_bright</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">6dp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <!-- Card style -->
    <style name="KafkaCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/kafka_card_elevated</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">6dp</item>
    </style>
    
    <!-- Dialog style -->
    <style name="KafkaDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:background">@drawable/kafka_dialog_bg_fixed</item>
        <item name="android:windowBackground">@drawable/kafka_dialog_bg_fixed</item>
        <item name="android:backgroundDimAmount">0.7</item>
        <item name="buttonBarPositiveButtonStyle">@style/KafkaDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/KafkaDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/KafkaDialogButton</item>
        
        <!-- Proper corner radius and insets -->
        <item name="shapeAppearanceOverlay">@style/KafkaDialogShape</item>
        <item name="backgroundInsetStart">24dp</item>
        <item name="backgroundInsetEnd">24dp</item>
        <item name="backgroundInsetTop">48dp</item>
        <item name="backgroundInsetBottom">48dp</item>
        
        <!-- Dialog text styling -->
        <item name="android:textColorPrimary">@color/kafka_text_primary</item>
        <item name="android:textColorSecondary">@color/kafka_text_secondary</item>
        <item name="android:fontFamily">sans-serif-light</item>
        
        <!-- List padding for proper alignment -->
        <item name="listPreferredItemPaddingLeft">24dp</item>
        <item name="listPreferredItemPaddingRight">24dp</item>
    </style>
    
    <style name="KafkaDialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    
    <style name="KafkaDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/kafka_thread_bright</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <!-- Tab layout style -->
    <style name="KafkaTabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabTextColor">@color/kafka_text_tertiary</item>
        <item name="tabSelectedTextColor">@color/kafka_thread_light</item>
        <item name="tabIndicatorColor">@color/kafka_thread_bright</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabRippleColor">@color/kafka_thread_glow</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="tabTextAppearance">@style/KafkaTabTextAppearance</item>
    </style>
    
    <style name="KafkaTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
    
    <!-- Text Input style -->
    <style name="KafkaTextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/kafka_thread_bright</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/kafka_thread_light</item>
        <item name="android:textColorHint">@color/kafka_text_secondary</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>
    
    <!-- Text styles for consistency -->
    <style name="KafkaTextTitle">
        <item name="android:textColor">@color/kafka_text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    
    <style name="KafkaTextSubtitle">
        <item name="android:textColor">@color/kafka_text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>
    
    <style name="KafkaTextBody">
        <item name="android:textColor">@color/kafka_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>
    
    <style name="KafkaTextCaption">
        <item name="android:textColor">@color/kafka_text_tertiary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>
</resources>
