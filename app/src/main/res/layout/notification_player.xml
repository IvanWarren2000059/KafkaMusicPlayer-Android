<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/notification_bg"
    android:gravity="center_vertical">

    <!-- Album Art -->
    <ImageView
        android:id="@+id/notifAlbumArt"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/kafka_default_album"
        android:scaleType="centerCrop"
        android:background="@drawable/album_art_border"/>

    <!-- Song Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/notifSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Song Title"
            android:textColor="@color/kafka_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/notifArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artist"
            android:textColor="@color/kafka_text_secondary"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/notifPrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/kafka_rose"
            android:contentDescription="Previous"/>

        <ImageButton
            android:id="@+id/notifPlayPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_play"
            android:background="@drawable/kafka_play_button_bg"
            android:tint="@android:color/white"
            android:contentDescription="Play/Pause"/>

        <ImageButton
            android:id="@+id/notifNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_next"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/kafka_rose"
            android:contentDescription="Next"/>
    </LinearLayout>
</LinearLayout>
