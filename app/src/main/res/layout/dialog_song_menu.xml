<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/kafka_dialog_bg"
    android:padding="0dp">
    
    <!-- Title -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Song Title"
        android:textColor="@color/kafka_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:padding="24dp"
        android:paddingBottom="16dp"
        android:maxLines="1"
        android:ellipsize="end"/>
    
    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/kafka_divider"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"/>
    
    <!-- Menu Items Container -->
    <LinearLayout
        android:id="@+id/menuItemsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">
        
        <TextView
            android:id="@+id/menuAddToPlaylist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add to Playlist"
            android:textColor="@color/kafka_text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-light"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>
        
        <TextView
            android:id="@+id/menuDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Song"
            android:textColor="@color/kafka_text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-light"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>
        
        <TextView
            android:id="@+id/menuInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Song Info"
            android:textColor="@color/kafka_text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-light"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
</LinearLayout>