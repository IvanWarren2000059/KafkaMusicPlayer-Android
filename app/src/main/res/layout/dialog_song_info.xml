<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/kafka_dialog_bg"
    android:padding="0dp">
    
    <!-- Title -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Song Information"
        android:textColor="@color/kafka_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:padding="24dp"
        android:paddingBottom="16dp"
        android:gravity="center"/>
    
    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/kafka_divider"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"/>
    
    <!-- Song Info Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">
        
        <TextView
            android:id="@+id/songTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Title:"
            android:textColor="@color/kafka_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-light"
            android:paddingTop="8dp"/>
        
        <TextView
            android:id="@+id/songTitleValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/kafka_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:paddingBottom="12dp"/>
        
        <TextView
            android:id="@+id/songArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artist:"
            android:textColor="@color/kafka_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-light"
            android:paddingTop="4dp"/>
        
        <TextView
            android:id="@+id/songArtistValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/kafka_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:paddingBottom="12dp"/>
        
        <TextView
            android:id="@+id/songUri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="URI:"
            android:textColor="@color/kafka_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-light"
            android:paddingTop="4dp"/>
        
        <TextView
            android:id="@+id/songUriValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/kafka_text_primary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:paddingBottom="8dp"/>
    </LinearLayout>
    
    <!-- OK Button -->
    <TextView
        android:id="@+id/okButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OK"
        android:textColor="@color/kafka_thread_bright"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"/>
</LinearLayout>
