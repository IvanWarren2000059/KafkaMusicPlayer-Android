<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/kafka_card_elevated"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/kafka_playlist_item_bg">

        <!-- Playlist Icon with elegant background -->
        <androidx.cardview.widget.CardView
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#33E84393">
            
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_playlist"
                android:tint="@color/kafka_thread_light"
                android:padding="12dp"
                android:scaleType="fitCenter"/>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/playlistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Playlist Name"
                android:textColor="@color/kafka_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/songCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 songs"
                android:textColor="@color/kafka_text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <!-- ✅ NEW: Delete button with Kafka styling -->
        <ImageButton
            android:id="@+id/deletePlaylistBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_delete"
            android:background="@drawable/kafka_icon_bg"
            android:tint="@color/kafka_rose"
            android:contentDescription="Delete playlist"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:layout_marginEnd="8dp"/>

        <!-- Arrow with thread color -->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_right"
            android:tint="@color/kafka_thread_bright"
            android:alpha="0.7"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>