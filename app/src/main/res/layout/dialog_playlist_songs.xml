<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/kafka_card_elevated"
    app:cardCornerRadius="20dp"
    app:cardElevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/kafka_dialog_bg">

        <!-- Title -->
        <TextView
            android:id="@+id/playlistTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Playlist Name"
            android:textSize="20sp"
            android:textColor="@color/kafka_thread_bright"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.03"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Empty State -->
        <TextView
            android:id="@+id/emptyPlaylistText"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:text="This playlist is empty\n\nTap 'Add Songs' to get started"
            android:textColor="@color/kafka_text_secondary"
            android:fontFamily="sans-serif-light"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:visibility="gone"/>

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlistSongsRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="400dp"
            android:scrollbars="vertical"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbarThumbVertical="@drawable/kafka_scrollbar"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
