<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kafka_gradient_bg">

    <!-- Header with Kafka aesthetic -->
    <TextView
        android:id="@+id/appTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KAFKA'S PLAYLIST"
        android:textColor="#E8D4F8"
        android:textSize="24sp"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Tab Layout for switching views -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A0D2E"
        app:tabTextColor="#B565A7"
        app:tabSelectedTextColor="#F5D5EF"
        app:tabIndicatorColor="#D484C4"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/appTitle">
        
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Songs"/>
        
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Playlists"/>
        
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Folders"/>
    </com.google.android.material.tabs.TabLayout>

    <!-- ViewPager for content -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toTopOf="@id/playerControlCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Mini Player Control Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/playerControlCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardBackgroundColor="#1F0F3D"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Song Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/albumArt"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/kafka_default_album"
                    android:scaleType="centerCrop"
                    android:background="@drawable/album_art_border"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/nowPlaying"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select a song..."
                        android:textColor="#E8D4F8"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"/>

                    <TextView
                        android:id="@+id/nowPlayingArtist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unknown Artist"
                        android:textColor="#9D7DBD"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <!-- Shuffle Button -->
                <ImageButton
                    android:id="@+id/shuffleBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_shuffle"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="#9D7DBD"
                    android:contentDescription="Shuffle"/>
            </LinearLayout>

            <!-- Playback Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <ImageButton
                    android:id="@+id/prevBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_previous"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="#C490E4"
                    android:contentDescription="Previous"/>

                <ImageButton
                    android:id="@+id/playPauseBtn"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_play"
                    android:background="@drawable/play_button_bg"
                    android:tint="#FFFFFF"
                    android:contentDescription="Play/Pause"/>

                <ImageButton
                    android:id="@+id/nextBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_next"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="#C490E4"
                    android:contentDescription="Next"/>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <!-- Playlist Button -->
                <ImageButton
                    android:id="@+id/playlistBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_playlist"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="#9D7DBD"
                    android:contentDescription="View Playlist"/>
            </LinearLayout>

            <!-- Progress Bar -->
            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:progressTint="#C490E4"
                android:thumbTint="#E8D4F8"
                android:progressBackgroundTint="#3D2966"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Floating Action Button for Add to Playlist -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddPlaylist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_add"
        app:backgroundTint="#5E3A8C"
        app:tint="#FFFFFF"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toTopOf="@id/playerControlCard"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Create Playlist"/>

</androidx.constraintlayout.widget.ConstraintLayout>