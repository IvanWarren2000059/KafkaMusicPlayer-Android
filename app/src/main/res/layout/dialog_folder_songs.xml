<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/kafka_dialog_bg"
    android:padding="20dp">

    <!-- Elegant Title -->
    <TextView
        android:id="@+id/folderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Folder Name"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/kafka_pale_pink"
        android:fontFamily="serif"
        android:paddingBottom="8dp"
        android:gravity="center"/>

    <!-- Decorative divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@drawable/kafka_divider_gradient"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Songs in this folder:"
        android:textSize="14sp"
        android:textColor="@color/kafka_text_secondary"
        android:paddingBottom="12dp"
        android:fontFamily="sans-serif-medium"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/folderSongsRecycler"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:scrollbars="vertical"
        android:scrollbarThumbVertical="@drawable/kafka_scrollbar"/>

</LinearLayout>